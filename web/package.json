{
  "name": "preact-ssr-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.tsx",
    "typecheck": "tsc --noEmit",
    "check:hydration": "node scripts/check-hydration.mjs",
    "prepare": "panda codegen"
  },
  "dependencies": {
    "core-js": "^3.51.0",
    "preact": "^11.1.1",
    "preact-iso": "^2.12.2",
    "preact-render-to-string": "^6.8.2"
  },
  "devDependencies": {
    "@pandacss/dev": "^2.4.0",
    "@pandacss/preset-base": "^2.4.0",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
